 "knowledge": [
  {
   "id": "kc-001",
   "type": "series",
   "title": "对白字幕密度是单部作品的形态选择，不是作者或系列指纹",
   "claim": "在抖音剧情短片里，「对白字幕格占比」的组内跨度（同一作者 0.000–0.903）大于组间跨度（各作者中位 0.351–0.860，极差 0.509），因此它不能用作作者指纹；同一系列内部也会换挡（ENEMY 前五部 0.000 → 民国篇 0.613）。画面文字必须与对白分列，否则「零对白但满屏系统红字」的作品会被算成有台词。",
   "maturity": "rule",
   "sample_size": 22,
   "creator_count": 10,
   "confidence": "medium",
   "status": "active",
   "works": [
    "w-0002",
