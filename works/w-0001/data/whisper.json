   "text": "这不让你睡看",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.494
  },
  {
   "id": 31,
   "start": 109.02,
   "end": 110.74,
   "text": "已经给你办好转学了",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.494
  },
