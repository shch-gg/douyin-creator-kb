   "avg_logprob": -0.377
  },
  {
   "id": 6,
   "start": 10.02,
   "end": 11.2,
   "text": "每晚都不能遇及",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 7,
   "start": 12.28,
   "end": 14.06,
   "text": "爸爸都是为了你",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 8,
   "start": 14.06,
   "end": 16.56,
   "text": "咱在这个家忍受呢",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 9,
   "start": 16.56,
   "end": 18.32,
   "text": "你一定要听话",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 10,
   "start": 18.32,
   "end": 19.22,
   "text": "知不知道",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 11,
   "start": 20.56,
   "end": 23.24,
   "text": "不然就是对不起妈妈",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.377
  },
  {
   "id": 12,
   "start": 23.86,
   "end": 25.3,
   "text": "都是为了你",
