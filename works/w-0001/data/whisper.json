   "avg_logprob": -0.377
  },
  {
   "id": 14,
   "start": 38.06,
   "end": 39.08,
   "text": "你干什么呢",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.798
  },
  {
   "id": 15,
   "start": 42.4,
   "end": 43.54,
   "text": "我上演在画这个",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.798
  },
  {
   "id": 16,
   "start": 45.76,
   "end": 47.38,
   "text": "我上演在学习啊",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.798
  },
  {
   "id": 17,
   "start": 64.22,
   "end": 65.88,
   "text": "你不欺负别人啊",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.71
  },
  {
   "id": 18,
   "start": 69.18,
   "end": 71.5,
   "text": "你怎么给你拉一个鞭呀",
   "no_speech_prob": 0.0,
   "avg_logprob": -0.71
  },
  {
   "id": 19,
   "start": 71.5,
   "end": 73.16,
   "text": "你怎么不去死啊",
